# ══════════════════════════════════════════════════════════════════════
# victor-201.github.io — Environment Variables
#
# Copy this file to .env and fill in real values.
# NEVER commit .env with real values — it is gitignored.
# ══════════════════════════════════════════════════════════════════════

# Spline 3D scene public URL
VITE_SPLINE_SCENE_URL=https://prod.spline.design/your-scene-id/scene.splinecode

# EmailJS Contact Form Integration
VITE_EMAILJS_PUBLIC_KEY=your_public_key
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id

# ── Victor Assistant Chatbot (Cloudflare Pages Function) ───────────────────────
# These are SERVER-SIDE variables. Set them in:
#   - Local dev:  .dev.vars  (for `wrangler pages dev`)
#   - Production: Cloudflare Pages dashboard > Settings > Environment variables
#
# GEMINI_API_KEY=your_gemini_api_key_here   ← get from https://aistudio.google.com/app/apikey
# GEMINI_MODEL=gemini-2.0-flash             ← or gemini-1.5-flash (free tier)
# ALLOWED_ORIGIN=https://victorfolio.pages.dev
